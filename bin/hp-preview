#!/usr/bin/env bash
# hp-preview open <file|url>   Show an .html/.md/.svg file or a web page in Herdr's Preview panel.
# hp-preview close         Close the preview.
set -euo pipefail
dir="$HOME/Library/Caches/herdr-preview"
usage() { echo "usage: hp-preview open <file|url> | hp-preview close" >&2; exit 2; }
[ $# -ge 1 ] || usage
mkdir -p "$dir"
case "$1" in
  open)
    [ $# -eq 2 ] || usage
    case "$2" in
      http://*|https://*) file="$2" ;;
      *)
        [ -f "$2" ] || { echo "hp-preview: no such file: $2" >&2; exit 1; }
        file="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")" ;;
    esac
    action=open ;;
  close) file=""; action=close ;;
  *) usage ;;
esac
seq="$(perl -MTime::HiRes=time -e 'printf "%d", time*1000')"
json_file="$(printf '%s' "$file" | perl -pe 's/\\/\\\\/g; s/"/\\"/g')"
tmp="$dir/.request.$$"
printf '{"action":"%s","file":"%s","seq":%s}\n' "$action" "$json_file" "$seq" > "$tmp"
mv "$tmp" "$dir/request.json"
if [ "$action" = open ] && command -v herdr-app >/dev/null 2>&1; then
  herdr-app do layout.select --stack panel-body --child preview >/dev/null 2>&1 || true
  herdr-app do layout.show --id panel >/dev/null 2>&1 || true
fi
